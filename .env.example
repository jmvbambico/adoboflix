# AdoboFlix environment configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# PostgreSQL connection string (required)
ADOBOFLIX_PG_URL=postgres://user:password@127.0.0.1:5432/yourdb?sslmode=disable

# Fallback alias (used if ADOBOFLIX_PG_URL is not set)
# MPDUMPY_PG_URL=postgres://user:password@127.0.0.1:5432/yourdb?sslmode=disable

# Backend bind address (default: 0.0.0.0)
# SERVER_HOST=0.0.0.0
# SERVER_PORT=5656

# Vite dev server proxy target (default: http://127.0.0.1:5656)
# ADOBOFLIX_API=http://127.0.0.1:5656
